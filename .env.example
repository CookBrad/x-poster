# x-poster Environment Variables (DEVELOPMENT ONLY)
#
# IMPORTANT SECURITY NOTES:
# - This file is for LOCAL DEVELOPMENT convenience only.
# - NEVER commit real API keys. .env and .env.local are gitignored.
# - Keys prefixed with VITE_ are exposed to the browser/renderer (Vite behavior).
# - For the final packaged macOS app, we will move to secure storage
#   (Tauri app data dir + OS keychain integration). Do not rely on .env in production builds.
#
# Copy this file to .env and fill in your keys:

# === xAI / Grok API (required for draft generation) ===
VITE_XAI_API_KEY=sk-...your-xai-key-here...

# === X (Twitter) API credentials ===
# Paste whatever format you have. We will support both OAuth 1.0a and OAuth 2.0.
# Examples (uncomment and fill the ones that match your keys):

# OAuth 1.0a (classic, very common for posting)
# VITE_X_API_KEY=your-consumer-api-key
# VITE_X_API_SECRET=your-consumer-api-secret
# VITE_X_ACCESS_TOKEN=your-access-token
# VITE_X_ACCESS_TOKEN_SECRET=your-access-token-secret

# OAuth 2.0 (Bearer or user context)
# VITE_X_CLIENT_ID=your-oauth2-client-id
# VITE_X_CLIENT_SECRET=your-oauth2-client-secret
# VITE_X_ACCESS_TOKEN=your-oauth2-access-token
# VITE_X_REFRESH_TOKEN=your-oauth2-refresh-token (if applicable)

# Optional: Unsplash for stock images (free tier)
# VITE_UNSPLASH_ACCESS_KEY=your-unsplash-key

# Development / debug
VITE_APP_ENV=development
